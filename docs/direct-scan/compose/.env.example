# Copy to .env and chmod 600 .env. Never commit .env or bake it into an image.
# Compose interpolates $ in this file too: write a robot name robot$scanner as robot$$scanner.
SCANNER_V2_AUTH_TOKEN=replace-with-at-least-32-random-characters
SCANNER_REGISTRY_USERNAME=robot$$scanner
SCANNER_REGISTRY_PASSWORD=replace-me
# Write and read concern are set in the URI; the scanner uses no transactions.
SCANNER_MONGO_URI=mongodb://scanner:replace-me@mongo:27017/scanner?authSource=admin&w=majority&readConcernLevel=majority
MONGO_INITDB_ROOT_USERNAME=scanner
MONGO_INITDB_ROOT_PASSWORD=replace-me
